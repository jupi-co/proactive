# Secrets — instance-specific, never commit.
# All plugin-owned instance state lives under .proactive-jupi/.
.proactive-jupi/config.local.json
.proactive-jupi/*.local.json
# Dev secrets (the .env.template beside it IS committed)
.proactive-jupi/.env
# Harness-owned local settings override (standard Claude Code convention).
# Glob, not per-file: a setup.local.json holding a live Neon connection string
# and a Supermemory key sat here untracked-but-unignored for five days.
.claude/*.local.json
.claude/settings.local.json

# Build artifacts (regenerated by scripts/package-plugin.sh / post-commit hook)
dist/

# Node deps for shared/db.mjs — installed at runtime by the skills' bootstrap, not vendored
node_modules/
package-lock.json

# macOS
.DS_Store

# Legacy config path (pre-#13 rename) — never commit.
.claude/proactive-jupi.local.json

# Eval run artifacts — regenerable, often large, sometimes carry real signal content
evals/*/workspace/
