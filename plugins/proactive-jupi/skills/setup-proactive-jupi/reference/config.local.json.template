{
  "_comment": "Copy to the workspace .proactive-jupi/config.local.json (gitignored) and fill in. Instance-specific; never commit.",
  "jupiWorkspace": "<jupi-workspace-slug>",
  "jupiUserId": "<resolved by setup step 2 from the authenticated Jupi caller — the tenant key across Neon + Supermemory; leave blank>",
  "neonProjectId": "<optional, informational — the Neon project id for reference; nothing in the pipeline reads it. Leave blank if unknown.>",
  "neonConnString": "postgres://<user>:<pass>@<host>/<db>?sslmode=require",
  "_supermemoryApiKey_note": "NOT here. The runtime uses the Supermemory MCP connector and needs no key. The dev-tooling key (HTTP-API ops + eval purge) lives in the gitignored .env at the repo root as SUPERMEMORY_API_KEY — this file gets mirrored into unattended/cloud run CWDs, so an admin key must not travel in it.",
  "seedTools": ["gmail", "calendar", "linear"],
  "crawlWindowDays": 30,
  "backlogWindowSize": 30,
  "businessRuleStore": {
    "_comment": "Where business rules live (Phase 5). Setup asks the user; default is a local markdown rulebook. Context searches READ this; a settled [BR] decision's business-rule-update action WRITES it (via execute-action), indexed in .proactive-jupi/assets.md.",
    "location": ".proactive-jupi/business-rules.md",
    "tool": "file",
    "readable": true
  },
  "ruleThreshold": 2,
  "guardrails": {
    "_comment": "act-or-decide policy (Phase 3). Default conservative; loosen as trust builds.",
    "mode": "draft",
    "actBudget": 5,
    "policy": {
      "high": { "low": "act",    "high": "decide" },
      "low":  { "low": "decide", "high": "decide" }
    },
    "executedPing": "none"
  }
}
